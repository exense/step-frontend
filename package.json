{
  "name": "step-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:core:lib": "ng build @exense/step-core",
    "build:core:resources": "cd projects/step-core && npm run build",
    "build:core:lint-rules": "node eslint-copy-rules.js",
    "build:core": "npm run build:core:lib && npm run build:core:resources && npm run build:core:lint-rules",
    "build:step-frontend:lib": "ng build @exense/step-frontend",
    "build:step-frontend:resources": "cd projects/step-frontend && npm run copyimages",
    "build:step-frontend": "npm run build:step-frontend:lib && npm run build:step-frontend:resources",
    "build:app": "ng build @exense/step-app",
    "build:app:local": "ng build @exense/step-app --configuration=local,production",
    "build": "npm run build:core && npm run build:step-frontend && npm run build:app",
    "build:local": "npm run build:core && npm run build:step-frontend && npm run build:app:local",
    "start:app": "ng serve",
    "start:app:local": "ng serve -c local",
    "start": "npm run build:core && npm run build:step-frontend  && npm run start:app",
    "start:local": "npm run build:core && npm run build:step-frontend && npm run start:app:local",
    "pack:core": "cd dist/step-core && npm pack",
    "pack:step-frontend": "cd dist/step-frontend && npm pack",
    "pack": "npm run pack:core && npm run pack:step-frontend",
    "format:fix": "pretty-quick --staged",
    "format:check": "prettier --config ./.prettierrc \"projects/{step-core/src/lib,step-frontend/src/lib,step-app/src}/!(angularjs)/**/*{.ts,.html,.scss}\"",
    "prepare": "husky install",
    "push": "npm publish projects/step-core/ --tag latest && npm publish dist/step-frontend/*.tgz --tag latest",
    "icons:generate": "node generate-icons.js",
    "openapi:generate:nhy": "node generate-openapi-client.js https://stepos-nhy.stepcloud-test.ch/rest/private-openapi.json",
    "openapi:generate:master": "node generate-openapi-client.js https://stepos-master.stepcloud-test.ch/rest/private-openapi.json",
    "openapi:generate": "node generate-openapi-client.js https://stepos-sed-4758.stepcloud-test.ch/rest/private-openapi.json",
    "lint:core": "ng lint @exense/step-core",
    "lint:step-frontend": "ng lint @exense/step-frontend",
    "lint:app": "ng lint @exense/step-app",
    "lint:all": "ng lint",
    "lint": "lint-staged",
    "deploy:core:copy": "copyfiles .npmrc dist/step-core",
    "deploy:core:publish": "cd dist/step-core && npm publish --tag latest",
    "deploy:core": "npm run deploy:core:copy && npm run deploy:core:publish --tag latest",
    "deploy:step-frontend:copy": "copyfiles .npmrc dist/step-frontend",
    "deploy:step-frontend:publish": "cd dist/step-frontend && npm publish --tag latest",
    "deploy:step-frontend": "npm run deploy:step-frontend:copy && npm run deploy:step-frontend:publish --tag latest",
    "deploy": "npm run deploy:core && npm run deploy:step-frontend",
    "test": "jest",
    "test:linter": "jest --config jest-lint.config.js"
  },
  "private": false,
  "dependencies": {
    "@angular-architects/native-federation": "20.3.1",
    "@angular/animations": "20.3.26",
    "@angular/cdk": "20.2.14",
    "@angular/cdk-experimental": "20.2.14",
    "@angular/common": "20.3.26",
    "@angular/compiler": "20.3.26",
    "@angular/core": "20.3.26",
    "@angular/forms": "20.3.26",
    "@angular/material": "20.2.14",
    "@angular/material-luxon-adapter": "20.2.14",
    "@angular/platform-browser": "20.3.26",
    "@angular/platform-browser-dynamic": "20.3.26",
    "@angular/router": "20.3.26",
    "@fontsource/roboto": "4.5.8",
    "@softarc/native-federation-node": "3.3.4",
    "ace-builds": "1.43.2",
    "angular-split": "20.0.0",
    "chart.js": "4.4.3",
    "chartjs-plugin-datalabels": "2.2.0",
    "es-module-shims": "^1.5.12",
    "feather-icons": "4.29.0",
    "luxon": "3.4.4",
    "marked": "15.0.12",
    "ngx-markdown": "20.1.0",
    "ngx-mat-select-search": "^8.0.6",
    "normalize.css": "8.0.1",
    "playwright-core": "1.55.0",
    "rxjs": "7.8.2",
    "tslib": "2.3.0",
    "uplot": "1.6.22",
    "uuid": "8.3.2",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "20.3.32",
    "@angular-eslint/builder": "20.7.0",
    "@angular-eslint/eslint-plugin": "20.7.0",
    "@angular-eslint/eslint-plugin-template": "20.7.0",
    "@angular-eslint/schematics": "20.7.0",
    "@angular-eslint/template-parser": "20.7.0",
    "@angular-eslint/test-utils": "20.7.0",
    "@angular/build": "20.3.32",
    "@angular/cli": "20.3.32",
    "@angular/compiler-cli": "20.3.26",
    "@happy-dom/jest-environment": "19.0.2",
    "@schematics/angular": "20.0.1",
    "@types/jest": "29.5.14",
    "@types/luxon": "3.4.2",
    "@types/node": "24.13.3",
    "@types/uuid": "8.3.4",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "@typescript-eslint/utils": "8.63.0",
    "angular-eslint": "20.7.0",
    "copyfiles": "2.4.1",
    "eslint": "^9.28.0",
    "husky": "7.0.4",
    "jest": "29.5.0",
    "jest-preset-angular": "14.6.2",
    "lint-staged": "16.2.3",
    "ng-lint-staged": "12.0.4",
    "ng-packagr": "^20.3.2",
    "npm-run-all": "4.1.5",
    "openapi-typescript-codegen": "0.23.0",
    "prettier": "3.7.4",
    "pretty-quick": "4.0.0",
    "shelljs": "0.9.2",
    "ts-jest": "29.4.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "lint-staged": {
    "projects/step-core/src/**/*.*": [
      "ng-lint-staged ng lint @exense/step-core --"
    ],
    "projects/step-frontend/src/**/*.*": [
      "ng-lint-staged ng lint @exense/step-frontend --"
    ],
    "projects/step-app/src/**/*.*": [
      "ng-lint-staged ng lint @exense/step-app --"
    ]
  }
}
